# Copy to yire/.env and replace the Supabase placeholders.
# Run from the repository root:
# python -m uvicorn yire.app:app --env-file yire/.env --host 127.0.0.1 --port 8000
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_EMAIL_REDIRECT_URL=http://127.0.0.1:8000/auth/confirmed
# Deployment: set the redirect URL above to your public HTTPS origin + /auth/confirmed.
