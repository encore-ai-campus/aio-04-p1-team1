# 이 파일을 .env로 복사한 뒤 실제 프로젝트 값으로 바꾸세요.

#  Supabase DB URL 
DATABASE_URL= 

# Supabase 이메일 인증
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_EMAIL_REDIRECT_URL=

# jev
JEV_API_KEY=

# 교육 모움/교육 추천 
# 고용24 국민내일배움카드 훈련과정 API
WORK24_API_KEY=
#GROQ API 키
GROQ_API_KEY=
GROQ_MODEL=

# 배포 관련 

# 로컬 환경변수(배포전)
APP_ENV=dev
HOST_URL=http://127.0.0.1:8000
SUPABASE_EMAIL_REDIRECT_URL=http://127.0.0.1:8000/auth/confirmed

